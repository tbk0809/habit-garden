{
  "name": "habit-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "node --env-file=.env.test scripts/integration.ts",
    "test": "npm run test:unit && npm run test:integration",
    "build": "next build",
    "test:e2e": "node scripts/not-ready.ts e2e",
    "db:migrate": "node --env-file=.env.local scripts/migrate.ts",
    "db:seed": "node --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
