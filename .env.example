# Copy to .env.local for runtime only. Replace every placeholder before use.
DATABASE_URL=postgresql://habit_garden_runtime:replace_runtime_password@127.0.0.1:55434/habit_garden_dev
MIGRATION_DATABASE_URL=postgresql://habit_garden_migrator:replace_owner_password@127.0.0.1:55434/habit_garden_dev
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
AUTH_GITHUB_ID=replace_with_github_oauth_client_id
AUTH_GITHUB_SECRET=replace_with_github_oauth_client_secret

# Docker Compose reads ignored .env, not .env.local. Use distinct random values.
LOCAL_DB_PASSWORD=replace_owner_password
LOCAL_RUNTIME_PASSWORD=replace_runtime_password

# Integration command reads ignored .env.test. It may reset only this exact DB.
TEST_DATABASE_URL=postgresql://habit_garden_migrator:replace_owner_password@127.0.0.1:55433/habit_garden_test
TEST_RUNTIME_DATABASE_URL=postgresql://habit_garden_runtime:replace_runtime_password@127.0.0.1:55433/habit_garden_test

# Explicit seed: npm run db:seed -- --local-development
# Seeded fictional users have no OAuth identity or login session. Real local
# sign-in requires a GitHub OAuth app/client and later task5 auth integration.
# Migration URL must use a direct PostgreSQL session, never transaction pooling.
